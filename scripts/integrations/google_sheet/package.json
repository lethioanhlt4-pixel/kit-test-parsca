{
  "name": "parsca-vendor-google-sheet-integration",
  "version": "1.0.0",
  "description": "Google Sheets integration scripts for kit-test-parsca (PARSCA Vendor)",
  "private": true,
  "scripts": {
    "read": "node sheet_reader.js",
    "read:list": "node sheet_reader.js --list",
    "read:sheet": "node sheet_reader.js --sheet",
    "write": "node sheet_writer.js",
    "write:results": "node sheet_writer.js --results",
    "write:excel": "node sheet_writer.js --excel",
    "write:testcases": "node sheet_writer.js --excel ../../../practices/testcases/vendor",
    "auth:verify": "node sheet_auth.js --verify",
    "auth:setup": "node sheet_auth.js --setup",
    "test:connection": "node sheet_reader.js --help"
  },
  "dependencies": {
    "axios": "1.14.0",
    "dotenv": "16.4.7",
    "googleapis": "^144.0.0",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
