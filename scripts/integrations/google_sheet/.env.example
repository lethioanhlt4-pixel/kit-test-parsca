# ============================================================
# GOOGLE SHEETS INTEGRATION (PARSCA Vendor) - Environment Variables
# ============================================================
# Copy file này thành .env và điền giá trị thực tế
#   cd scripts/integrations/google_sheet && cp .env.example .env
#
# QUAN TRỌNG: KHÔNG commit file .env và service-account.json vào Git!
# ============================================================

# --- Cách xác thực (chọn 1 trong 2 cách) ---
#
# CÁCH 1: Service Account (khuyến nghị cho CI/CD & automation)
# - Tải file credentials JSON từ Google Cloud Console
# - Đường dẫn tương đối tính từ thư mục scripts/integrations/google_sheet/
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account.json

# CÁCH 2: API Key (chỉ dùng cho Sheets public / read-only)
# - Tạo API Key tại: https://console.cloud.google.com/apis/credentials
# - Lưu ý: API Key không thể ghi data, chỉ đọc Sheets công khai
# GOOGLE_API_KEY=your-google-api-key-here

# --- Google Sheets Configuration ---

# Spreadsheet ID của bộ test PARSCA Vendor — lấy từ URL của Google Sheet:
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id-here

# Sheet name mặc định (tab đầu tiên nếu bỏ trống)
GOOGLE_SHEET_NAME=Sheet1

# --- Output Configuration ---

# Thư mục lưu file output của sheet_reader.js (relative từ gốc kit-test-parsca/)
OUTPUT_DIR=practices/requirements/google_sheet

# Timezone để format timestamp trong report
TIMEZONE=Asia/Ho_Chi_Minh

# --- Test Results Sheet Configuration ---
# Tên sheet dùng để ghi kết quả test automation (sheet_writer.js --results)
# Cột: TC ID | Module | Title | Status | Duration (ms) | Error | Tags | File | Run At | Retries | Doc
# Status: PASS | FAIL | OBSERVED (@CodeHienTai) | BLOCKED | SKIP
RESULTS_SHEET_NAME=PARSCA Vendor Results

# Header row số (row đầu tiên chứa tên cột) - default: 1
RESULTS_HEADER_ROW=1
